# Copie para .env e ajuste conforme necessário.

# --- Trecho e datas padrão (já configurados para a viagem solicitada) ---
FF_ORIGIN=GYN
FF_DESTINATION=MCZ
FF_DEPARTURE=2026-08-15
FF_RETURN=2026-08-22
FF_ADULTS=1
FF_CURRENCY=BRL

# Tarifa (R$) abaixo da qual a oferta vira "promoção relâmpago"
FF_FLASH_THRESHOLD=700

# Desconto mínimo sobre a mediana para marcar um "achado" (0.15 = 15%)
FF_DEAL_DISCOUNT=0.15

# --- Provedor de dados ---
# auto = usa Amadeus se houver credenciais, senão modo demonstração
# amadeus = força a API real | demo = força dados de demonstração
FF_PROVIDER=auto

# --- Credenciais da API Amadeus (gratuita: https://developers.amadeus.com) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Ambiente de teste por padrão; produção: https://api.amadeus.com
AMADEUS_HOST=https://test.api.amadeus.com
