# Copie para .env e ajuste conforme necessário.

# --- Trecho e datas padrão (já configurados para a viagem solicitada) ---
FF_ORIGIN=GYN
FF_DESTINATION=MCZ
FF_DEPARTURE=2026-08-15
FF_RETURN=2026-08-22
FF_ADULTS=1
FF_CURRENCY=BRL

# Tarifa (R$) abaixo da qual a oferta vira "promoção relâmpago"
FF_FLASH_THRESHOLD=700

# Desconto mínimo sobre a mediana para marcar um "achado" (0.15 = 15%)
FF_DEAL_DISCOUNT=0.15

# --- Provedor de dados ---
# auto = melhor fonte disponível: Skyscanner (RapidAPI) > Amadeus > demo
# skyscanner = força a API Skyscanner | amadeus = força Amadeus | demo = demonstração
FF_PROVIDER=auto

# --- Skyscanner via RapidAPI (gratuito, sem cartão) ---
# 1) Crie conta em https://rapidapi.com
# 2) Assine a API "Sky-Scrapper" (apiheya) — plano free
# 3) Copie sua X-RapidAPI-Key abaixo
RAPIDAPI_KEY=
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# --- Credenciais da API Amadeus (gratuita: https://developers.amadeus.com) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Ambiente de teste por padrão; produção: https://api.amadeus.com
AMADEUS_HOST=https://test.api.amadeus.com
